<!--
 VARIANTE DE LINEA DE ORDENES. NO ABRIR EN EL GRAPH BUILDER.
 ==========================================================
 Gemelo de graph_s1_slc_crudo.xml, identico salvo en una cosa: las rutas
 y el recorte van escritos como marcadores ${...}, que es lo que la herramienta
 gpt sustituye con sus opciones -P. En el Graph Builder de la interfaz grafica
 esos marcadores se leen como texto literal y la lista de bandas sale vacia; por
 eso existe la otra variante, y por eso conviene no mezclarlas.

 POR QUE HAY DOS ARCHIVOS (31/07/2026). El 27/07/2026 se les quitaron los
 marcadores a los grafos para que abrieran limpio en la interfaz. La decision era
 buena para el aula, pero dejo sin efecto a los lanzadores
 TP4_01_procesar_sar.py y TP4_02_recortar_crudo.py, que siguen pasando -Pentrada,
 -Psalida y -Pgeowkt: gpt solo sustituye donde encuentra el token, y sin token el
 nodo Read se queda sin archivo. Los productos de 02_Subsets_SNAP_QGIS llevan fecha del 13
 y 14 de julio, o sea anteriores al cambio, que es la prueba de que hasta
 entonces la cadena corria. Separar los dos usos en dos archivos deja funcionando
 a los dos.

 QUE SE EDITA AQUI: nada. Los valores los pone el lanzador de Python.
 QUE SE EDITA EN EL OTRO ARCHIVO: las rutas, a mano, para una corrida suelta.
 Los dos comparten el resto de los parametros: si se cambia uno hay que cambiar
 el otro, y conviene comprobarlo con una comparacion de archivos.

 Marcadores que espera este grafo: entrada, salida, subswath, geowkt
-->
<graph id="S1_SLC_recorte_crudo_InSAR">
  <!-- RECORTE CRUDO de Sentinel-1 IW SLC.
       Conserva la GEOMETRIA DE RADAR y la FASE COMPLEJA (bandas i y q), de modo
       que el producto sigue siendo apto para interferometria y polarimetria.
       NO se calibra, NO se aplana el terreno y NO se geocodifica: eso lo hace
       el otro flujo (graph_s1_slc_tc.xml), que produce gamma0 en la grilla
       comun pero pierde la fase.

       TOPSAR-Split selecciona la subfranja (IW1, IW2 o IW3) y, mediante el
       parametro wktAoi, unicamente las rafagas (bursts) que cubren el AOI.
       El resultado pesa unos cientos de MB en lugar de 7,8 GB. -->
  <version>1.0</version>
  <node id="Read">
    <operator>Read</operator>
    <sources/>
    <parameters><file>${entrada}</file></parameters>
  </node>
  <node id="TOPSAR-Split">
    <operator>TOPSAR-Split</operator>
    <sources><sourceProduct refid="Read"/></sources>
    <parameters>
      <subswath>${subswath}</subswath>
      <selectedPolarisations>VV,VH</selectedPolarisations>
      <wktAoi>${geowkt}</wktAoi>
    
      <firstBurstIndex>1</firstBurstIndex>
      <lastBurstIndex>9999</lastBurstIndex>
    </parameters>
  </node>
  <node id="Apply-Orbit-File">
    <operator>Apply-Orbit-File</operator>
    <sources><sourceProduct refid="TOPSAR-Split"/></sources>
    <parameters>
      <orbitType>Sentinel Precise (Auto Download)</orbitType>
      <continueOnFail>true</continueOnFail>
    
      <polyDegree>3</polyDegree>
    </parameters>
  </node>
  <node id="Write">
    <operator>Write</operator>
    <sources><sourceProduct refid="Apply-Orbit-File"/></sources>
    <parameters>
      <file>${salida}</file>
      <formatName>BEAM-DIMAP</formatName>
    </parameters>
  </node>
  <applicationData id="Presentation">
    <Description/>
    <node id="Read">
      <displayPosition x="15.0" y="20.0"/>
    </node>
    <node id="TOPSAR-Split">
      <displayPosition x="220.0" y="20.0"/>
    </node>
    <node id="Apply-Orbit-File">
      <displayPosition x="425.0" y="20.0"/>
    </node>
    <node id="Write">
      <displayPosition x="15.0" y="82.0"/>
    </node>
  </applicationData>
</graph>
